<?php
session_start();

if (!isset($_SESSION['user_id'])) {
    header('Location: login.php');
    exit;
}

/*
|--------------------------------------------------------------------------
| KIá»‚M TRA ÄÄ‚NG NHáº¬P VÃ€ PHÃ‚N QUYá»€N
|--------------------------------------------------------------------------
*/

require_once __DIR__ . '/config/auth.php';

requireLogin();

$isAdmin = isAdmin();

require_once __DIR__ . '/config/database.php';


$message = '';
$error = '';


/*
|--------------------------------------------------------------------------
| THÃŠM DANH Má»¤C
|--------------------------------------------------------------------------
*/

if (
    $_SERVER['REQUEST_METHOD'] === 'POST'
    && ($_POST['action'] ?? '') === 'add'
    && $isAdmin
) {

    $categoryName = trim(
        $_POST['category_name'] ?? ''
    );

    $description = trim(
        $_POST['description'] ?? ''
    );

    if ($categoryName === '') {

        $error =
            'TÃªn danh má»¥c khÃ´ng Ä‘Æ°á»£c Ä‘á»ƒ trá»‘ng.';

    } else {

        $check = $pdo->prepare("
            SELECT COUNT(*)
            FROM categories
            WHERE category_name = ?
        ");

        $check->execute([
            $categoryName
        ]);

        if (
            (int) $check->fetchColumn() > 0
        ) {

            $error =
                'Danh má»¥c nÃ y Ä‘Ã£ tá»“n táº¡i.';

        } else {

            $insert = $pdo->prepare("
                INSERT INTO categories (
                    category_name,
                    description
                )
                VALUES (?, ?)
            ");

            $insert->execute([
                $categoryName,
                $description
            ]);

            header(
                'Location: categories.php?message=added'
            );

            exit;
        }
    }
}


/*
|--------------------------------------------------------------------------
| Cáº¬P NHáº¬T DANH Má»¤C
|--------------------------------------------------------------------------
*/

if (
    $_SERVER['REQUEST_METHOD'] === 'POST'
    && ($_POST['action'] ?? '') === 'update'
    && $isAdmin
) {

    $id = (int) (
        $_POST['id'] ?? 0
    );

    $categoryName = trim(
        $_POST['category_name'] ?? ''
    );

    $description = trim(
        $_POST['description'] ?? ''
    );

    if (
        $id <= 0
        || $categoryName === ''
    ) {

        $error =
            'Dá»¯ liá»‡u cáº­p nháº­t khÃ´ng há»£p lá»‡.';

    } else {

        $check = $pdo->prepare("
            SELECT COUNT(*)
            FROM categories
            WHERE category_name = ?
            AND id != ?
        ");

        $check->execute([
            $categoryName,
            $id
        ]);

        if (
            (int) $check->fetchColumn() > 0
        ) {

            $error =
                'TÃªn danh má»¥c Ä‘Ã£ tá»“n táº¡i.';

        } else {

            $update = $pdo->prepare("
                UPDATE categories
                SET
                    category_name = ?,
                    description = ?
                WHERE id = ?
            ");

            $update->execute([
                $categoryName,
                $description,
                $id
            ]);

            header(
                'Location: categories.php?message=updated'
            );

            exit;
        }
    }
}


/*
|--------------------------------------------------------------------------
| XÃ“A DANH Má»¤C
|--------------------------------------------------------------------------
*/

if (
    $isAdmin
    && isset($_GET['delete'])
    && $_GET['delete'] !== ''
) {

    $id = (int) $_GET['delete'];

    if ($id > 0) {

        $checkProduct = $pdo->prepare("
            SELECT COUNT(*)
            FROM products
            WHERE category_id = ?
        ");

        $checkProduct->execute([
            $id
        ]);

        if (
            (int) $checkProduct
                ->fetchColumn() > 0
        ) {

            header(
                'Location: categories.php?message=used'
            );

            exit;
        }

        $delete = $pdo->prepare("
            DELETE FROM categories
            WHERE id = ?
        ");

        $delete->execute([
            $id
        ]);

        header(
            'Location: categories.php?message=deleted'
        );

        exit;
    }
}


/*
|--------------------------------------------------------------------------
| Láº¤Y DANH Má»¤C Cáº¦N Sá»¬A
|--------------------------------------------------------------------------
*/

$editCategory = null;

if (
    $isAdmin
    && isset($_GET['edit'])
    && $_GET['edit'] !== ''
) {

    $id = (int) $_GET['edit'];

    $selectEdit = $pdo->prepare("
        SELECT *
        FROM categories
        WHERE id = ?
    ");

    $selectEdit->execute([
        $id
    ]);

    $editCategory = $selectEdit
        ->fetch(PDO::FETCH_ASSOC);
}


/*
|--------------------------------------------------------------------------
| THÃ”NG BÃO
|--------------------------------------------------------------------------
*/

if (
    isset($_GET['message'])
) {

    if (
        $_GET['message'] === 'added'
    ) {

        $message =
            'ThÃªm danh má»¥c thÃ nh cÃ´ng.';
    }

    if (
        $_GET['message'] === 'updated'
    ) {

        $message =
            'Cáº­p nháº­t danh má»¥c thÃ nh cÃ´ng.';
    }

    if (
        $_GET['message'] === 'deleted'
    ) {

        $message =
            'XÃ³a danh má»¥c thÃ nh cÃ´ng.';
    }

    if (
        $_GET['message'] === 'used'
    ) {

        $error =
            'KhÃ´ng thá»ƒ xÃ³a vÃ¬ danh má»¥c Ä‘ang cÃ³ sáº£n pháº©m.';
    }
}


/*
|--------------------------------------------------------------------------
| Láº¤Y DANH SÃCH DANH Má»¤C
|--------------------------------------------------------------------------
*/

$categories = $pdo
    ->query("
        SELECT *
        FROM categories
        ORDER BY id ASC
    ")
    ->fetchAll(
        PDO::FETCH_ASSOC
    );

?>

