*/

$products = $pdo
    ->query("
        SELECT
            products.id,
            products.product_code,
            products.product_name,
            products.unit,
            products.import_price,
            products.sale_price,
            products.quantity,

            categories.category_name,

            suppliers.supplier_name

        FROM products

        LEFT JOIN categories

            ON products.category_id
            = categories.id

        LEFT JOIN suppliers

            ON products.supplier_id
            = suppliers.id

        ORDER BY
        products.id ASC
    ")
    ->fetchAll(
        PDO::FETCH_ASSOC
    );

/*
|--------------------------------------------------------------------------
| Tá»”NG Há»¢P Sá» LIá»†U
|--------------------------------------------------------------------------
*/

$totalProducts =
    count($products);

$totalQuantity = 0;

$totalValue = 0;

$outOfStock = 0;

$lowStock = 0;

foreach (
    $products
    as $product
) {

    $quantity =
        (int) $product[
            'quantity'
        ];

    $importPrice =
        (float) $product[
            'import_price'
        ];

    $totalQuantity +=
        $quantity;

    $totalValue +=
        $quantity
        * $importPrice;

    if (
        $quantity <= 0
    ) {

        $outOfStock++;

    } elseif (
        $quantity <= 10
    ) {

        $lowStock++;
    }
}

