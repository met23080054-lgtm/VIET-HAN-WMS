<?php

session_start();

/*
|--------------------------------------------------------------------------
| KIỂM TRA ĐĂNG NHẬP
|--------------------------------------------------------------------------
*/

if (!isset($_SESSION['user_id'])) {

    header('Location: login.php');

    exit;
}

/*
|--------------------------------------------------------------------------
| KIỂM TRA QUYỀN ADMIN
|--------------------------------------------------------------------------
*/

$isAdmin = isset($_SESSION['role'])
    && mb_strtolower(
        trim($_SESSION['role'])
    ) === 'admin';

require_once __DIR__ . '/config/database.php';

$message = '';

$error = '';

/*
|--------------------------------------------------------------------------
| THÊM NHÀ CUNG CẤP
|--------------------------------------------------------------------------
*/

if (
    $_SERVER['REQUEST_METHOD'] === 'POST'
    && ($_POST['action'] ?? '') === 'add'
    && $isAdmin
) {

    $supplierName = trim(
        $_POST['supplier_name'] ?? ''
    );

    $phone = trim(
        $_POST['phone'] ?? ''
    );

    $email = trim(
        $_POST['email'] ?? ''
    );

    $address = trim(
        $_POST['address'] ?? ''
    );

    if ($supplierName === '') {

        $error =
            'Tên nhà cung cấp không được để trống.';

    } else {

        $check = $pdo->prepare("
            SELECT COUNT(*)
            FROM suppliers
            WHERE supplier_name = ?
        ");

        $check->execute([
            $supplierName
        ]);

        if (
            (int) $check->fetchColumn() > 0
        ) {

            $error =
                'Nhà cung cấp này đã tồn tại.';

        } else {

            $insert = $pdo->prepare("
                INSERT INTO suppliers (
                    supplier_name,
                    phone,
                    email,
                    address
                )
                VALUES (?, ?, ?, ?)
            ");

            $insert->execute([
                $supplierName,
                $phone,
                $email,
                $address
            ]);

            header(
                'Location: suppliers.php?message=added'
            );

            exit;
        }
    }
}

/*
|--------------------------------------------------------------------------
| CẬP NHẬT NHÀ CUNG CẤP
|--------------------------------------------------------------------------
*/

if (
    $_SERVER['REQUEST_METHOD'] === 'POST'
    && ($_POST['action'] ?? '') === 'update'
    && $isAdmin
) {

    $id = (int) (
        $_POST['id'] ?? 0
    );

    $supplierName = trim(
        $_POST['supplier_name'] ?? ''
    );

    $phone = trim(
        $_POST['phone'] ?? ''
    );

    $email = trim(
        $_POST['email'] ?? ''
    );

    $address = trim(
        $_POST['address'] ?? ''
    );

    if (
        $id <= 0
        || $supplierName === ''
    ) {

        $error =
            'Dữ liệu cập nhật không hợp lệ.';

    } else {

        $check = $pdo->prepare("
            SELECT COUNT(*)
            FROM suppliers
            WHERE supplier_name = ?
            AND id != ?
        ");

        $check->execute([
            $supplierName,
            $id
        ]);

        if (
            (int) $check->fetchColumn() > 0
        ) {

            $error =
                'Tên nhà cung cấp đã tồn tại.';

        } else {

            $update = $pdo->prepare("
                UPDATE suppliers
                SET
                    supplier_name = ?,
                    phone = ?,
                    email = ?,
                    address = ?
                WHERE id = ?
            ");

            $update->execute([
                $supplierName,
                $phone,
                $email,
                $address,
                $id
            ]);

            header(
                'Location: suppliers.php?message=updated'
            );

            exit;
        }
    }
}

/*
|--------------------------------------------------------------------------
| XÓA NHÀ CUNG CẤP
|--------------------------------------------------------------------------
*/

if (
    $isAdmin
    && isset($_GET['delete'])
    && $_GET['delete'] !== ''
) {

    $id = (int) $_GET['delete'];

    if ($id > 0) {

        $checkProduct = $pdo->prepare("
            SELECT COUNT(*)
            FROM products
            WHERE supplier_id = ?
        ");

        $checkProduct->execute([
            $id
        ]);

        if (
            (int) $checkProduct
                ->fetchColumn() > 0
        ) {

            header(
                'Location: suppliers.php?message=used'
            );

            exit;
        }

        $delete = $pdo->prepare("
            DELETE FROM suppliers
            WHERE id = ?
        ");

        $delete->execute([
            $id
        ]);

        header(
            'Location: suppliers.php?message=deleted'
        );

        exit;
    }
}

/*
|--------------------------------------------------------------------------
| LẤY NHÀ CUNG CẤP CẦN SỬA
|--------------------------------------------------------------------------
*/

$editSupplier = null;

if (
    $isAdmin
    && isset($_GET['edit'])
    && $_GET['edit'] !== ''
) {

    $id = (int) $_GET['edit'];

    $selectEdit = $pdo->prepare("
        SELECT *
        FROM suppliers
        WHERE id = ?
    ");

    $selectEdit->execute([
        $id
    ]);

    $editSupplier = $selectEdit
        ->fetch(PDO::FETCH_ASSOC);
}

/*
|--------------------------------------------------------------------------
| THÔNG BÁO
|--------------------------------------------------------------------------
*/

if (isset($_GET['message'])) {

    if ($_GET['message'] === 'added') {

        $message =
            'Thêm nhà cung cấp thành công.';
    }

    if ($_GET['message'] === 'updated') {

        $message =
            'Cập nhật nhà cung cấp thành công.';
    }

    if ($_GET['message'] === 'deleted') {

        $message =
            'Xóa nhà cung cấp thành công.';
    }

    if ($_GET['message'] === 'used') {

        $error =
            'Không thể xóa vì nhà cung cấp đang được sử dụng.';
    }
}

/*
|--------------------------------------------------------------------------
| LẤY DANH SÁCH NHÀ CUNG CẤP
|--------------------------------------------------------------------------
*/

$search = trim($_GET['search'] ?? '');

if ($search !== '') {
    $stmt = $pdo->prepare(
"
        SELECT *
        FROM suppliers
        WHERE supplier_name LIKE ?
        ORDER BY id DESC
    
"
);
    $stmt->execute([
        '%' . $search . '%'
    ]);
    $suppliers = $stmt->fetchAll(
        PDO::FETCH_ASSOC
    );
} else {
    $suppliers = $pdo
        ->query(
"
            SELECT *
            FROM suppliers
            ORDER BY id DESC
        
"
)
        ->fetchAll(
            PDO::FETCH_ASSOC
        );
}

?>

